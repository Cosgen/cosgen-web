"use client";

import React, { useState, useEffect, Suspense } from "react";
import { useSearchParams } from "next/navigation";
import Link from "next/link";
import {
  Search,
  CheckCircle2,
  Clock,
  Lock,
  ExternalLink,
  MessageCircle,
  AlertTriangle,
  Folder,
  DollarSign,
  ShieldCheck,
  Phone,
  Timer,
} from "lucide-react";
import { LandingNavbar } from "@/components/landing/navbar";
import { LandingFooter } from "@/components/landing/footer";
import { OrderInvoiceSummary } from "@/components/landing/order-invoice-summary";
import { MidtransSnapModal } from "@/components/landing/midtrans-snap-modal";
import { OrderRevisionChat } from "@/components/landing/order-revision-chat";
import { ReviewStatusBanner } from "@/components/landing/review-status-banner";
import { getStoredOrders, OrderData, updateSingleOrder } from "@/lib/order-store";

function CekStatusContent() {
  const searchParams = useSearchParams();
  const initialCode = searchParams?.get("code") || "";

  const [inputCode, setInputCode] = useState(initialCode);
  const [allOrders, setAllOrders] = useState<OrderData[]>([]);
  const [currentOrder, setCurrentOrder] = useState<OrderData | null>(null);

  // Modals state
  const [snapModalOpen, setSnapModalOpen] = useState(false);
  const [revisionChatOpen, setRevisionChatOpen] = useState(false);

  useEffect(() => {
    const fetchOrders = () => {
      const orders = getStoredOrders();
      setAllOrders(orders);

      const targetCode = (inputCode || initialCode || "ORD-3302").trim().toUpperCase();
      const found = orders.find(
        (o) =>
          o.code.toUpperCase() === targetCode ||
          (o.officialCode && o.officialCode.toUpperCase() === targetCode)
      );
      if (found) {
        setCurrentOrder(found);
      } else if (orders.length > 0) {
        setCurrentOrder(orders[2] || orders[0]);
      }
    };

    fetchOrders();

    const handleUpdate = () => fetchOrders();
    window.addEventListener("cosgen_orders_updated", handleUpdate);
    window.addEventListener("storage", handleUpdate);
    return () => {
      window.removeEventListener("cosgen_orders_updated", handleUpdate);
      window.removeEventListener("storage", handleUpdate);
    };
  }, [inputCode, initialCode]);

  const handleSearch = (e: React.FormEvent) => {
    e.preventDefault();
    const clean = inputCode.trim().toUpperCase();
    if (!clean) return;

    const orders = getStoredOrders();
    const found = orders.find(
      (o) =>
        o.code.toUpperCase() === clean ||
        (o.officialCode && o.officialCode.toUpperCase() === clean)
    );

    if (found) {
      setCurrentOrder(found);
    } else {
      alert(`Kode pesanan "${clean}" tidak ditemukan dalam database.`);
    }
  };

  const steps = [
    { title: "Form Disubmit", key: "REQ" },
    { title: "Konfirmasi Admin", key: "Menunggu Konfirmasi" },
    { title: "Dalam Antrian", key: "Dalam Antrian" },
    { title: "Sedang Dikerjakan", key: "Sedang Dikerjakan" },
    { title: "Review Hasil", key: "Review" },
    { title: "Pembayaran & Selesai", key: "Selesai" },
  ];

  const getStepIndex = (status: OrderData["status"]) => {
    switch (status) {
      case "Menunggu Konfirmasi": return 1;
      case "Dalam Antrian": return 2;
      case "Sedang Dikerjakan": return 3;
      case "Review": return 4;
      case "Menunggu Pembayaran": return 4;
      case "Selesai": return 5;
      case "Ditolak": return -1;
      default: return 0;
    }
  };

  const currentStepIdx = currentOrder ? getStepIndex(currentOrder.status) : 0;

  return (
    <div className="space-y-6 max-w-4xl mx-auto font-sans text-xs">
      {/* Page Title (Small UI version) */}
      <div className="text-center space-y-1">
        <h1 className="text-xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Portal Cek Status Pesanan
        </h1>
        <p className="text-[11px] text-slate-500 max-w-md mx-auto">
          Masukkan Kode REQ-XXXX atau Kode ORD-XXXX untuk melacak progress edit foto secara real-time.
        </p>
      </div>

      {/* Search Bar (Small UI version) */}
      <form onSubmit={handleSearch} className="max-w-md mx-auto flex gap-2">
        <div className="relative flex-1">
          <Search className="w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" />
          <input
            type="text"
            placeholder="Masukkan Kode: REQ-8942 / ORD-3302"
            value={inputCode}
            onChange={(e) => setInputCode(e.target.value)}
            className="w-full pl-9 pr-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-mono font-bold uppercase focus:ring-2 focus:ring-blue-600/20 focus:outline-none shadow-xs"
          />
        </div>
        <button
          type="submit"
          className="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold shadow-xs shrink-0"
        >
          Cari Status
        </button>
      </form>

      {/* Order Status Display Box */}
      {currentOrder && (
        <div className="bg-white rounded-2xl p-5 sm:p-7 border border-slate-200 shadow-lg space-y-6">
          {/* Header info */}
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
            <div>
              <span className="text-[10px] font-bold text-slate-400 uppercase tracking-widest block">
                Kode Penelusuran Order:
              </span>
              <div className="text-2xl font-mono font-black text-blue-600 tracking-tight">
                {currentOrder.officialCode || currentOrder.code}
              </div>
              <p className="text-[11px] text-slate-500 mt-0.5">
                Atas Nama: <strong>{currentOrder.customerName}</strong> • Paket <strong>{currentOrder.package}</strong>
              </p>
            </div>

            <div className="flex items-center gap-2">
              <span
                className={`px-3 py-1 rounded-full text-[11px] font-extrabold shadow-xs ${
                  currentOrder.status === "Menunggu Konfirmasi"
                    ? "bg-amber-100 text-amber-800 border border-amber-300"
                    : currentOrder.status === "Review"
                    ? "bg-purple-100 text-purple-800 border border-purple-300"
                    : currentOrder.status === "Selesai"
                    ? "bg-emerald-100 text-emerald-800 border border-emerald-300"
                    : currentOrder.status === "Ditolak"
                    ? "bg-red-100 text-red-800 border border-red-300"
                    : "bg-blue-100 text-blue-800 border border-blue-300"
                }`}
              >
                Status: {currentOrder.status}
              </span>
            </div>
          </div>

          {/* Rejection Alert */}
          {currentOrder.status === "Ditolak" && (
            <div className="p-4 bg-red-50 border border-red-200 rounded-xl space-y-1.5 text-red-900 text-xs">
              <div className="flex items-center gap-2 font-bold text-xs text-red-700">
                <AlertTriangle className="w-4 h-4 text-red-600" /> Pesanan Ditolak Oleh Admin
              </div>
              <p className="text-[11px] text-red-800 leading-relaxed bg-white p-3 rounded-lg border border-red-200 font-sans">
                <strong>Alasan Penolakan:</strong> "{currentOrder.rejectionReason || "Penolakan oleh admin."}"
              </p>
            </div>
          )}

          {/* Progress Timeline Tracker */}
          {currentOrder.status !== "Ditolak" && (
            <div className="space-y-3">
              <h3 className="text-[11px] font-bold text-slate-700 uppercase tracking-wider">
                Progres Pengerjaan Transparan:
              </h3>

              <div className="grid grid-cols-2 sm:grid-cols-6 gap-2">
                {steps.map((st, idx) => {
                  const isDone = currentStepIdx > idx;
                  const isCurrent = currentStepIdx === idx;

                  return (
                    <div
                      key={idx}
                      className={`p-2.5 rounded-xl border text-center space-y-0.5 transition-all ${
                        isCurrent
                          ? "bg-blue-600 text-white border-blue-700 shadow-md scale-[1.02]"
                          : isDone
                          ? "bg-blue-50 text-blue-800 border-blue-200"
                          : "bg-slate-50 text-slate-400 border-slate-200/60"
                      }`}
                    >
                      <span className="text-[9px] font-bold block opacity-80">Tahap #{idx + 1}</span>
                      <span className="text-[11px] font-extrabold block leading-tight">{st.title}</span>
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          {/* RED WARNING BANNER FOR REVIEW STATUS */}
          {currentOrder.status === "Review" && (
            <ReviewStatusBanner
              orderCode={currentOrder.officialCode || currentOrder.code}
              gdriveReviewUrl={currentOrder.gdriveReviewUrl}
              onOpenRevisionChat={() => setRevisionChatOpen(true)}
            />
          )}

          {/* Payment Section */}
          {(currentOrder.status === "Review" || currentOrder.status === "Menunggu Pembayaran") && (
            <div className="p-4 bg-slate-50 border border-slate-200 rounded-xl space-y-3">
              <div className="flex items-center justify-between text-xs">
                <span className="font-bold text-slate-800 uppercase tracking-wider">
                  Status Pembayaran Midtrans:
                </span>
                {currentOrder.isAccByAdmin || currentOrder.status === "Menunggu Pembayaran" ? (
                  <span className="px-2.5 py-0.5 bg-emerald-100 text-emerald-800 text-[11px] font-bold rounded-full border border-emerald-300">
                    ✓ Terkonfirmasi ACC (Pembayaran Terbuka)
                  </span>
                ) : (
                  <span className="px-2.5 py-0.5 bg-amber-100 text-amber-800 text-[11px] font-bold rounded-full border border-amber-300">
                    🔒 Terkunci (Menunggu Konfirmasi Admin)
                  </span>
                )}
              </div>

              {/* Invoice Breakdown */}
              <OrderInvoiceSummary
                orderCode={currentOrder.officialCode || currentOrder.code}
                packageName={currentOrder.package}
                basePrice={currentOrder.totalAmount}
                totalAmount={currentOrder.totalAmount}
              />

              {/* Pay Now Button */}
              <button
                type="button"
                disabled={!currentOrder.isAccByAdmin && currentOrder.status !== "Menunggu Pembayaran"}
                onClick={() => setSnapModalOpen(true)}
                className={`w-full py-3 rounded-xl font-bold text-xs shadow-md transition-all flex items-center justify-center gap-1.5 ${
                  currentOrder.isAccByAdmin || currentOrder.status === "Menunggu Pembayaran"
                    ? "bg-emerald-600 hover:bg-emerald-700 text-white shadow-emerald-600/25"
                    : "bg-slate-300 text-slate-500 cursor-not-allowed shadow-none"
                }`}
              >
                <DollarSign className="w-4 h-4" />
                <span>
                  {currentOrder.isAccByAdmin || currentOrder.status === "Menunggu Pembayaran"
                    ? "Bayar Sekarang (Midtrans QRIS / VA)"
                    : "Pembayaran Terkunci (Tunggu Konfirmasi ACC Admin)"}
                </span>
              </button>
            </div>
          )}

          {/* Download Final Files Section (When Selesai) */}
          {currentOrder.status === "Selesai" && currentOrder.gdriveFinalUrl && (
            <div className="p-4 bg-emerald-50 border border-emerald-200 rounded-xl space-y-2 text-emerald-950 text-xs">
              <div className="flex items-center gap-1.5 font-bold text-xs text-emerald-900">
                <CheckCircle2 className="w-4 h-4 text-emerald-600" /> Pesanan Telah Selesai & Lunas!
              </div>
              <p className="text-[11px] text-emerald-800">
                Terima kasih telah mempercayai CosGen.id! Unduh berkas foto hasil final HD tanpa watermark melalui pranala Google Drive di bawah ini.
              </p>
              <a
                href={currentOrder.gdriveFinalUrl}
                target="_blank"
                rel="noreferrer"
                className="inline-flex items-center gap-1.5 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-lg shadow-xs"
              >
                <Folder className="w-3.5 h-3.5" /> Unduh Berkas Final HD di GDrive
              </a>
            </div>
          )}
        </div>
      )}

      {/* Modals */}
      {currentOrder && (
        <>
          <MidtransSnapModal
            isOpen={snapModalOpen}
            onClose={() => setSnapModalOpen(false)}
            orderCode={currentOrder.officialCode || currentOrder.code}
            totalAmount={currentOrder.totalAmount}
            onPaymentSuccess={() => {
              updateSingleOrder(currentOrder.id, { status: "Selesai" });
              alert("Pembayaran Berhasil! Status berubah menjadi Selesai.");
            }}
          />

          <OrderRevisionChat
            isOpen={revisionChatOpen}
            onClose={() => setRevisionChatOpen(false)}
            orderCode={currentOrder.officialCode || currentOrder.code}
          />
        </>
      )}
    </div>
  );
}

export default function CekStatusPage() {
  return (
    <div className="min-h-screen bg-slate-50 text-slate-900 font-sans flex flex-col justify-between">
      <LandingNavbar />
      <main className="px-4 py-8 w-full">
        <Suspense fallback={<div className="text-center text-xs py-10">Loading...</div>}>
          <CekStatusContent />
        </Suspense>
      </main>
      <LandingFooter />
    </div>
  );
}
