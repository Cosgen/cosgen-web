            Pesan Sekarang
          </button>

          {onOpenSlotChecker && (
            <button
              type="button"
              onClick={onOpenSlotChecker}
              className="bg-white/10 hover:bg-white/20 border border-white/30 text-white text-[11px] sm:text-xs font-bold px-4 py-2 rounded-full transition-all hover:scale-105 active:scale-95 backdrop-blur-md shadow-md"
            >
              Cek Slot
            </button>
          )}
        </div>
      </div>
    </section>
