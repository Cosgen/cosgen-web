"use client";

import React from "react";
import { User, Phone, ArrowRight, ShieldCheck } from "lucide-react";

interface CustomerStep1FormProps {
  nickname: string;
  setNickname: (val: string) => void;
  whatsapp: string;
  setWhatsapp: (val: string) => void;
  instagram: string;
  setInstagram: (val: string) => void;
  onNext: () => void;
  onBack: () => void;
}

export function CustomerStep1Form({
  nickname,
  setNickname,
  whatsapp,
  setWhatsapp,
  instagram,
  setInstagram,
  onNext,
  onBack,
}: CustomerStep1FormProps) {
  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!nickname.trim()) return alert("Harap isi Nama Panggilan.");
    onNext();
  };

  return (
    <form onSubmit={handleSubmit} className="space-y-4 font-sans text-xs">
      <div className="space-y-1">
        <h3 className="text-base font-bold text-slate-900 flex items-center gap-2">
          <User className="w-4 h-4 text-blue-600" /> Tahap 1: Data Identitas Pelanggan
        </h3>
        <p className="text-[11px] text-slate-500">
          Isi data panggilan & kontak agar kami dapat menghubungi Anda saat foto selesai.
        </p>
      </div>

      <div className="space-y-3">
        {/* Nickname Input */}
        <div>
          <label className="block text-[11px] font-semibold text-slate-700 mb-0.5">
            Nama Panggilan <span className="text-red-500">*</span>
          </label>
          <div className="relative">
            <User className="w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" />
            <input
              type="text"
              required
              placeholder="Misal: Aria Pratama"
              value={nickname}
              onChange={(e) => setNickname(e.target.value)}
              className="w-full pl-9 pr-3 py-2 rounded-lg border border-slate-200 text-xs focus:ring-2 focus:ring-blue-600/20 focus:outline-none"
            />
          </div>
        </div>

        {/* WhatsApp Input */}
        <div>
          <label className="block text-[11px] font-semibold text-slate-700 mb-0.5">
            Nomor WhatsApp <span className="text-slate-400 font-normal">(Opsional)</span>
          </label>
          <div className="relative">
            <Phone className="w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" />
            <input
              type="tel"
              placeholder="085183016367"
              value={whatsapp}
              onChange={(e) => setWhatsapp(e.target.value)}
              className="w-full pl-9 pr-3 py-2 rounded-lg border border-slate-200 text-xs focus:ring-2 focus:ring-blue-600/20 focus:outline-none"
            />
          </div>
        </div>

        {/* Instagram Input */}
        <div>
          <label className="block text-[11px] font-semibold text-slate-700 mb-0.5">
            Username Instagram <span className="text-slate-400 font-normal">(Opsional)</span>
          </label>
          <div className="relative">
            <svg
              className="w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
              viewBox="0 0 24 24"
            >
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
            </svg>
            <input
              type="text"
              placeholder="@aria_cosplay"
              value={instagram}
              onChange={(e) => setInstagram(e.target.value)}
              className="w-full pl-9 pr-3 py-2 rounded-lg border border-slate-200 text-xs focus:ring-2 focus:ring-blue-600/20 focus:outline-none"
            />
          </div>
        </div>
      </div>

      <div className="flex items-center justify-between pt-3 border-t border-slate-100">
        <button
          type="button"
          onClick={onBack}
          className="px-3.5 py-2 rounded-lg border border-slate-200 text-xs font-semibold text-slate-600 hover:bg-slate-50"
        >
          Batal
        </button>
        <button
          type="submit"
          className="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-bold shadow-sm flex items-center gap-1.5"
        >
          <span>Lanjut ke Tahap 2</span>
          <ArrowRight className="w-3.5 h-3.5" />
        </button>
      </div>
    </form>
  );
}
