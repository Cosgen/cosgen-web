"use client";

import React, { useState, useEffect } from "react";
import { Calendar, X, Sparkles } from "lucide-react";

interface SlotAvailabilityCheckerProps {
  isOpen: boolean;
  onClose: () => void;
  onProceedOrder: () => void;
}

export function SlotAvailabilityChecker({
  isOpen,
  onClose,
  onProceedOrder,
}: SlotAvailabilityCheckerProps) {
  const [totalSlots, setTotalSlots] = useState(25);
  const [usedSlots] = useState(17);
  const [holidays, setHolidays] = useState<number[]>([5, 12, 17, 26]);

  useEffect(() => {
    const savedData = localStorage.getItem("cosgen_scheduler_data");
    if (savedData) {
      try {
        const parsed = JSON.parse(savedData);
        if (parsed.totalSlots) setTotalSlots(parsed.totalSlots);
        if (parsed.holidays) setHolidays(parsed.holidays);
      } catch (e) {
        console.error(e);
      }
    }
  }, [isOpen]);

  if (!isOpen) return null;

  const remainingSlots = Math.max(0, totalSlots - usedSlots);
  const daysInMonth = Array.from({ length: 31 }, (_, i) => i + 1);

  return (
    <div className="fixed inset-0 z-[100] bg-slate-950/75 backdrop-blur-sm flex items-center justify-center p-4 font-sans text-xs">
      <div className="bg-white rounded-3xl max-w-sm w-full p-5 sm:p-6 shadow-2xl border border-slate-100 relative space-y-4 max-h-[85vh] overflow-y-auto">
        {/* Close Button */}
        <button
          type="button"
          onClick={onClose}
          className="absolute top-4 right-4 p-1.5 rounded-full text-slate-400 hover:text-slate-900 hover:bg-slate-100 transition-colors"
        >
          <X className="w-4 h-4" />
        </button>

        {/* Header */}
        <div className="space-y-1 text-center">
          <div className="w-10 h-10 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center mx-auto shadow-xs">
            <Calendar className="w-5 h-5" />
          </div>
          <h3 className="text-base font-extrabold text-slate-900">
            Cek Ketersediaan Slot Pengerjaan
          </h3>
          <p className="text-[11px] text-slate-500">
            Kapasitas pengerjaan foto cosplay bulan ini dipantau secara real-time.
          </p>
        </div>

        {/* Status Metrics Box (Consistent Balanced Square Cards) */}
        <div className="grid grid-cols-2 gap-2.5">
          <div className="p-3.5 bg-emerald-50 border border-emerald-200 rounded-2xl text-center flex flex-col items-center justify-center space-y-1 aspect-square">
            <span className="text-[9px] font-bold uppercase text-emerald-700 tracking-wider block">
              Sisa Slot
            </span>
            <div className="text-2xl font-black text-emerald-600 font-mono">
              {remainingSlots} Slot
            </div>
            <span className="text-[9px] text-emerald-800 font-semibold block">
              Siap Menerima
            </span>
          </div>

          <div className="p-3.5 bg-slate-50 border border-slate-200 rounded-2xl text-center flex flex-col items-center justify-center space-y-1 aspect-square">
            <span className="text-[9px] font-bold uppercase text-slate-500 tracking-wider block">
              Total Kuota
            </span>
            <div className="text-2xl font-black text-slate-900 font-mono">
              {totalSlots} Slot
            </div>
            <span className="text-[9px] text-slate-400 block">
              Terisi: {usedSlots}
            </span>
          </div>
        </div>

        {/* Calendar View (Balanced Square Days) */}
        <div className="space-y-2">
          <div className="flex items-center justify-between text-[11px] font-bold text-slate-700">
            <span>Jadwal Studio:</span>
            <span className="text-[9px] text-red-500 flex items-center gap-1">
              <span className="w-2 h-2 rounded-full bg-red-500 inline-block" /> Merah = Libur
            </span>
          </div>

          <div className="grid grid-cols-7 gap-1 text-center text-[10px]">
            {["S", "S", "R", "K", "J", "S", "M"].map((d, i) => (
              <div key={i} className="font-bold text-slate-400 py-0.5">
                {d}
              </div>
            ))}

            {daysInMonth.map((day) => {
              const isHoliday = holidays.includes(day);
              return (
                <div
                  key={day}
                  className={`aspect-square rounded-lg font-bold text-[10px] flex items-center justify-center ${
                    isHoliday
                      ? "bg-red-500 text-white shadow-xs"
                      : "bg-slate-100 text-slate-700"
                  }`}
                >
                  {day}
                </div>
              );
            })}
          </div>
        </div>

        {/* Action CTA */}
        <div className="pt-1">
          <button
            type="button"
            onClick={onProceedOrder}
            className="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold shadow-md shadow-blue-600/20 flex items-center justify-center gap-1.5"
          >
            <Sparkles className="w-3.5 h-3.5" /> Slot Tersedia — Pesan Sekarang
          </button>
        </div>
      </div>
    </div>
  );
}
